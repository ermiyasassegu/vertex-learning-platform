# Vertex web app environment variables.
# Copy this file to .env.local and fill in the real values. Only NEXT_PUBLIC_*
# values reach the browser; every other value stays on the server.

# --- Sanity (content) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-31
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
# Server-only tokens for the private dataset. Never expose these to the browser.
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# --- Clerk (authentication) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only. Never expose this to the browser.
CLERK_SECRET_KEY=

# --- PostHog (product analytics) ---
# The project token is public by design and may reach the browser.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Optional. Leave empty to default to EU cloud. Set it for US cloud.
NEXT_PUBLIC_POSTHOG_HOST=
